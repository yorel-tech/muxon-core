# Copy to muxon-core/initial-config.yaml and edit for your environment.
#   cp compose/initial-config.yaml.template ../initial-config.yaml
#
# Internal profile (Docker): use service hostnames postgres and keycloak.
# External: set datasource.url and system.idp.metadata.issuerUri to your endpoints.

muxon:
  instanceName: "docker"
  instanceId: 1

  system:
    systemAdminUserName: "admin@example.com"
    idp:
      name: "default-idp"
      protocol: "OIDC"
      metadata:
        # Internal compose: Keycloak listens on 8085 in the container.
        issuerUri: "http://keycloak:8085/realms/muxon-dev"
        clientId: "muxon-api"
        clientSecret: "provide-in-secrets"

  tenants:
    - name: "default"
      idpName: "default-idp"
      tenantAdminUserName: "admin@example.com"

  datasource:
    # Internal: host "postgres", DB "muxon", user "muxon"
    # Password is NOT set here — it comes from the Docker secret muxon-db-password
    # (file ../secrets/muxon-db-password), same value PostgreSQL uses.
    url: jdbc:postgresql://postgres:5432/muxon
    username: muxon
    password: placeholder-not-used
    driver-class-name: org.postgresql.Driver
